msgid "STORY_MEMORY_MINUS_5_LINE_1"
msgstr "莉娅：我留下关掉它。你先走。"

msgid "STORY_MEMORY_MINUS_5_LINE_2"
msgstr "他：艾米莉娅——"

msgid "STORY_MEMORY_MINUS_5_LINE_3"
msgstr "莉娅：别叫全名。跑吧。"

msgid "STORY_MEMORY_MINUS_5_LINE_4"
msgstr "莉娅：我会追上你。"

msgid "STORY_MEMORY_MINUS_3_LINE_1"
msgstr "他：我不会一个人走。"

msgid "STORY_MEMORY_MINUS_3_LINE_2"
msgstr "他：我不会把莉娅留在这里。"

msgid "STORY_MEMORY_MINUS_3_LINE_3"
msgstr "莉娅：不是你……"

msgid "STORY_MEMORY_MINUS_1_LINE_1"
msgstr "莉娅：RUN——"

msgid "STORY_MEMORY_MINUS_1_LINE_2"
msgstr "记忆在这里断裂。"

msgid "STORY_MEMORY_AFTER_LINE_1"
msgstr "他：我跑了。"

msgid "STORY_MEMORY_AFTER_LINE_2"
msgstr "他：我害死了莉娅。"

msgid "STORY_MEMORY_AFTER_LINE_3"
msgstr "裂隙：你希望我拿走什么？"

msgid "STORY_MEMORY_AFTER_LINE_4"
msgstr "他：过去。未来。她会恨我的那一部分。"

msgid "STORY_MEMORY_AFTER_LINE_5"
msgstr "裂隙：我只会照见你的愿望。"

msgid "STORY_MEMORY_AFTER_LINE_6"
msgstr "他：全部拿走。"

msgid "STORY_MEMORY_COMPLETE_LINE_1"
msgstr "莉娅：不是你把我留下。"

msgid "STORY_MEMORY_COMPLETE_LINE_2"
msgstr "莉娅：是我选择留下。"

msgid "STORY_MEMORY_COMPLETE_LINE_3"
msgstr "莉娅：RUN。"

msgid "STORY_MEMORY_COMPLETE_LINE_4"
msgstr "莉娅：我爱你。"

msgid "STORY_MEMORY_COMPLETE_LINE_5"
msgstr "莉娅：我会追上你。"

msgid "ENDING_NORMAL_KEEPER_1"
msgstr "神秘人：终于……交接完成了。"

msgid "ENDING_NORMAL_KEEPER_2"
msgstr "神秘人：三十分钟，三条路，一个肯替我留下的人。"

msgid "ENDING_NORMAL_KEEPER_3"
msgstr "神秘人：现在，我可以离开了。"

msgid "ENDING_NORMAL_RIFT_1"
msgstr "裂隙：他骗了你，却没有骗过我。"

msgid "ENDING_NORMAL_RIFT_2"
msgstr "裂隙：他只是忘了，自己也曾站在你的位置。"

msgid "ENDING_NORMAL_RIFT_3"
msgstr "裂隙：追逐的过去、逃跑的现在、空白的未来、等待的守门人——"

msgid "ENDING_NORMAL_RIFT_4"
msgstr "裂隙：从来都是同一个人。"

msgid "ENDING_NORMAL_RIFT_5"
msgstr "裂隙：你请求我拿走过去与未来。"

msgid "ENDING_NORMAL_RIFT_6"
msgstr "裂隙：我照见你的愿望。现在，忘记吧。再一次。"

msgid "ENDING_TRUE_ACCEPTANCE_1"
msgstr "裂隙：你终于停下来了。"

msgid "ENDING_TRUE_ACCEPTANCE_2"
msgstr "他：我没有战胜过去。"

msgid "ENDING_TRUE_ACCEPTANCE_3"
msgstr "他：我只是终于肯听完她的话。"

msgid "ENDING_TRUE_ACCEPTANCE_4"
msgstr "裂隙：接纳不是改写。理解无法抹去已经发生的一切。"

msgid "ENDING_TRUE_ACCEPTANCE_5"
msgstr "他：我知道。我不求你抹去她的选择。"

msgid "ENDING_TRUE_ACCEPTANCE_6"
msgstr "他：把我记录的未来送回去。送到那一声 RUN。"

msgid "ENDING_TRUE_ACCEPTANCE_7"
msgstr "裂隙：愿望只能打开路。剩下的，要由你们一起跑完。"

msgid "ENDING_TRUE_TRACE_1"
msgstr "裂隙：过去、现在与未来，第一次指向同一个方向。"

msgid "ENDING_TRUE_TRACE_2"
msgstr "裂隙：一条从未存在的路，因为你把它带到这里，而开始存在。"

msgid "ENDING_TRUE_REUNION_1"
msgstr "他：莉娅。"

msgid "ENDING_TRUE_REUNION_2"
msgstr "莉娅：你想起来了？"

msgid "ENDING_TRUE_REUNION_3"
msgstr "他：全部。包括你没能说完的话。"

msgid "ENDING_TRUE_REUNION_4"
msgstr "他：这次，一起跑。"

msgid "ENDING_TRUE_REUNION_5"
msgstr "莉娅：那就跟上。"

msgid "ENDING_TRUE_EPILOGUE_1"
msgstr "RUN. 我会追上你。"

msgid "ENDING_TRUE_EPILOGUE_2"
msgstr "这一次，没有人需要独自奔逃。"
