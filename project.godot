[internationalization]

locale/translations=PackedStringArray("res://translations/delay_trace.en.po", "res://translations/delay_trace.zh_CN.po")
locale/translations_pot_files=PackedStringArray("res://Dialogue/Examples/demo/demo_dialogue.dialogue", "res://Dialogue/Examples/demo/illustration_test.dialogue", "res://Dialogue/Examples/demo/scene1_tutorial.dialogue", "res://Dialogue/Examples/demo/scene2_characters.dialogue", "res://Dialogue/Examples/demo/scene3_branch.dialogue", "res://Dialogue/Examples/demo/scene3_branches.dialogue", "res://Dialogue/EchoChase/present_hub.dialogue", "res://Dialogue/EchoChase/story_sequences.dialogue")

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Past Echo"
2d_physics/layer_4="Future Echo"
2d_physics/layer_5="Temporal Trigger"
2d_physics/layer_6="Trap"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"

[richer_text_label]

colors={}
fonts={
&"Nunito": "res://addons/phantom_camera/fonts/Nunito-Regular.ttf",
&"Nunito-Black": "res://addons/phantom_camera/fonts/Nunito-Black.ttf",
&"SmileySans-Oblique": "res://assets/fonts/SmileySans-Oblique.ttf"
