; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="延迟追迹"
config/description="过去的自己沿着延迟轨迹追上现在；未来可能性短暂重演后消散。"
config/version="0.2.0-jam"
run/main_scene="res://Scenes/UI/Menu/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
SaveSystem="*res://addons/enhance_save_system/core/save_system.gd"
SceneManager="*res://addons/scene_manager/autoload/scene_manager.tscn"
GuiTransitions="*res://addons/simple-gui-transitions/singleton.gd"
GameAudio="*res://Scenes/Autoload/game_audio.tscn"
FeedbackOverlay="*res://Scenes/UI/Common/feedback_overlay.tscn"
EchoTimeline="*res://Scenes/Autoload/echo_timeline_controller.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="GodotHubJam"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/enhance_save_system/plugin.cfg", "res://addons/godot_terrain_authoring/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/richtext2/plugin.cfg", "res://addons/scene_manager/plugin.cfg", "res://addons/simple-gui-transitions/plugin.cfg")

[gui_transitions]

config/default/auto_start=true
config/default/fade_layout=true
config/default/center_pivot=true
config/default/duration=0.5
config/default/delay=0.5
config/default/transition_type="QUAD"
config/default/ease_type="IN_OUT"
config/default/animation_enter=4
config/default/animation_leave=4

[input]

echo_move_left={
"deadzone": 0.2,
